{
  "name": "frontend-main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "preview": "node ../../scripts/deploy-frontend.js preview",
    "deploy": "node ../../scripts/deploy-frontend.js deploy",
    "upload": "node ../../scripts/deploy-frontend.js upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@tsudev/identity-token": "*",
    "@tsudev/search": "*",
    "@tsudev/types": "*",
    "dotenv": "^16.3.1",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "autoprefixer": "^10.6.2",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "wrangler": "^4.148.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.next/",
      "<rootDir>/.open-next/"
    ]
  }
}

{
  "name": "frontend-main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "preview": "node ../../scripts/deploy-frontend.js preview",
    "deploy": "node ../../scripts/deploy-frontend.js deploy",
    "upload": "node ../../scripts/deploy-frontend.js upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "@tsudev/identity-token": "*",
    "@tsudev/search": "*",
    "@tsudev/types": "*",
    "dotenv": "^18.0.10",
    "marked": "18.3.0",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.161.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.next/",
      "<rootDir>/.open-next/"
    ],
    "moduleNameMapper": {
      "^marked$": "<rootDir>/../../node_modules/marked/lib/marked.umd.js"
    }
  }
}

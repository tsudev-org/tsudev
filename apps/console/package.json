{
  "name": "console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/copy-shared-assets.js",
    "build": "next build --webpack",
    "predev": "node scripts/copy-shared-assets.js",
    "dev": "next dev -p 3001",
    "deploy": "node ../../scripts/deploy-frontend.js deploy --app console",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test jest --runInBand"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-list": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/markdown": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tsudev/identity-token": "*",
    "@tsudev/search": "*",
    "@tsudev/types": "*",
    "@tsudev/ui": "*",
    "dompurify": "3.5.0",
    "marked": "17.0.6",
    "next": "16.4.6",
    "next-auth": "^4.24.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "wrangler": "^4.161.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.next/",
      "<rootDir>/.open-next/"
    ],
    "moduleNameMapper": {
      "^marked$": "<rootDir>/../../node_modules/marked/lib/marked.umd.js"
    }
  }
}

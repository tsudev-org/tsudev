{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Worker RIÊNG của cổng xác thực (CP4, ADR-0005). Không đặt tên `tsudev` - đó là Worker công khai.
  "name": "tsudev-id",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // CHỈ tên miền của cổng. Tắt *.workers.dev và URL xem trước: một origin thứ hai của trang đăng nhập là thứ kẻ
  // lừa đảo cần, và passkey cũng không chạy ở đó (origin ngoài danh sách của auth-service).
  "routes": [{ "pattern": "id.tsudev.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Biến LÚC CHẠY, chỉ giá trị KHÔNG bí mật. Secret (`wrangler secret put`): NEXTAUTH_SECRET (CÙNG Worker `tsudev` -
  // cookie phiên chung ở CP4a), EDGE_SIGNING_KEY (CÙNG Worker `tsudev`), INTERNAL_IDENTITY_SECRET_ID (vùng ký RIÊNG
  // của cổng, cùng giá trị biến Render; bản gốc ~/.config/tsudev/keys/id.env), TURNSTILE_SITE_KEY. Worker cổng KHÔNG
  // giữ INTERNAL_IDENTITY_SECRET (vùng main).
  //
  // NEXTAUTH_ZONE=id: NextAuth ở đây giữ provider mật khẩu, passkey, QR; Google/GitHub tạm ở tsudev.com tới khi
  // callback của hai nhà cung cấp trỏ về cổng. Cookie phiên CP4a vẫn `.tsudev.com` (chung) - CP4b đổi `__Host-`.
  "vars": {
    "CONTENT_SERVICE_URL": "https://tsudev-backend.onrender.com",
    "STORAGE_SERVICE_URL": "https://tsudev-backend.onrender.com",
    "AUTH_SERVICE_URL": "https://tsudev-backend.onrender.com",
    "NEXTAUTH_URL": "https://id.tsudev.com",
    "NEXTAUTH_COOKIE_DOMAIN": ".tsudev.com",
    "NEXTAUTH_ZONE": "id",
  },
}

{
  "name": "tsudev-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "env:local": "node scripts/write-env-local.js",
    "cron:typecheck": "tsc --noEmit -p infrastructure/canh-site-cron/tsconfig.json",
    "cron:deploy": "npm --prefix infrastructure/canh-site-cron exec -- wrangler deploy --config infrastructure/canh-site-cron/wrangler.jsonc",
    "cron:secret-telegram": "npm --prefix infrastructure/canh-site-cron run secret-telegram",
    "cron:secret-neon": "npm --prefix infrastructure/canh-site-cron run secret-neon",
    "cron:secret-integrity": "npm --prefix infrastructure/canh-site-cron run secret-integrity",
    "cron:tail": "npx wrangler tail --config infrastructure/canh-site-cron/wrangler.jsonc",
    "dev": "npm run env:local && concurrently \"npm --workspace services/content-service run dev\" \"npm --workspace services/storage-service run dev\" \"npm --workspace services/auth-service run dev\" \"npm --workspace apps/frontend-main run dev\"",
    "dev:local": "npm run build:ts && node scripts/run-dev.js",
    "bootstrap": "npm ci",
    "dev:services": "concurrently \"npm --workspace services/content-service run dev\" \"npm --workspace services/storage-service run dev\" \"npm --workspace services/auth-service run dev\"",
    "dev:merged": "node services/backend-bundle/src/index.js",
    "dev:frontends": "npm run env:local && concurrently \"npm --workspace apps/frontend-main run dev\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "e2e": "npm run build:services && playwright test --config=e2e/playwright.config.js",
    "e2e:app": "npm run build:services && playwright test --config=e2e/playwright.config.js --project=app",
    "topology:gen": "node scripts/topology/gen-env.js",
    "topology:check": "node scripts/topology/check.js && node scripts/topology/gen-env.js --check",
    "tokens:sync": "node scripts/sync-tokens.js",
    "tokens:check": "node scripts/sync-tokens.js --check",
    "fonts:sync": "node scripts/sync-fonts.js",
    "fonts:check": "node scripts/sync-fonts.js --check",
    "icons:check": "node scripts/check-icons.js",
    "db:up": "bash scripts/start-db.sh",
    "host:manifest": "bash scripts/host-manifest.sh",
    "minio:up": "bash scripts/start-minio.sh",
    "db:migrate": "node scripts/with-env.js npm --workspace packages/db run migrate:deploy",
    "db:generate": "npm --workspace packages/db run generate",
    "db:seed": "node scripts/with-env.js npm --workspace packages/db run seed",
    "db:reset": "node scripts/with-env.js npm --workspace packages/db exec -- prisma migrate reset --force",
    "dev:full": "npm run db:up && npm run minio:up && npm run db:generate && npm run db:migrate && npm run db:seed && npm run build:services && npm run db:seed:dev && npm run dev:local",
    "typecheck": "npm run build:ts && npm --workspace apps/frontend-main run typecheck && npm run cron:typecheck",
    "typecheck:ts7": "node scripts/typecheck-ts7.js",
    "build:ts": "tsc -b",
    "build:services": "tsc -b tsconfig.services.json",
    "db:seed:dev": "node scripts/with-env.js node services/auth-service/scripts/seed-dev-users.js",
    "prod:dem-noi-dung": "node scripts/dem-noi-dung-prod.js",
    "r2:cors": "npx wrangler r2 bucket cors set tsudev --file infrastructure/r2/cors.tsudev.json",
    "r2:cors:list": "npx wrangler r2 bucket cors list tsudev"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next-auth": "^4.24.15",
    "playwright": "^1.59.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "^5.5.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "glob@>=10.2.0 <10.5.0": "^10.5.0",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}

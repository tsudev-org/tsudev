{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tsudev-org/tsudev-standards/main/tokens/products/product.schema.json",
  "title": "TsuDEV - lớp bản sắc sản phẩm",
  "description": "Một tệp tokens/products/<id>.json cho mỗi sản phẩm có giao diện. Danh sách enum là danh mục DUY NHẤT được dùng (docs/DESIGN_SYSTEM.md mục 1.2); thêm giá trị mới = sửa file này + tài liệu trong cùng PR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "repo", "seed", "hue", "chroma", "layout", "shape", "motif", "fontDisplay", "colors"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Giá trị của <html data-product=\"...\">" },
    "name": { "type": "string", "description": "Tên hiển thị đã chốt" },
    "repo": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex", "source", "note", "measured"],
      "properties": {
        "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$", "description": "Màu đo từ logo (trung bình điểm ảnh của nhóm sắc độ)" },
        "source": { "type": "string", "description": "Đường dẫn ảnh gốc trong repo sản phẩm" },
        "note": { "type": "string", "description": "Vì sao hue chọn như vậy" },
        "measured": { "type": "string", "pattern": "^\\d{2}/\\d{2}/\\d{4}$" }
      }
    },
    "hue": { "type": "number", "minimum": 0, "exclusiveMaximum": 360, "description": "Sắc độ OKLCH của màu chính" },
    "chroma": { "type": "number", "minimum": 0.08, "maximum": 0.3 },
    "layout": {
      "enum": ["cong", "trinh-dien", "cong-cu", "bang-dieu-khien", "do-luong", "tai-lieu"],
      "description": "Kiểu bố cục chữ ký, DESIGN_SYSTEM.md mục 1.2.2"
    },
    "shape": { "enum": ["sac", "chuan", "mem", "tron"], "description": "Bộ bo góc, DESIGN_SYSTEM.md mục 1.2.3" },
    "motif": {
      "enum": ["quang-sang", "luoi-quet", "mach-in", "the-xep", "quy-dao", "canh-sen", "duong-bieu-do", "cot-tang-truong", "khoi-phan-vung", "song-am", "vong-dong-tam", "cham-luoi", "song-cheo"],
      "description": "Hoạ tiết chữ ký ở hero, mỗi sản phẩm một hoạ tiết riêng, DESIGN_SYSTEM.md mục 1.2.4"
    },
    "fontDisplay": {
      "enum": ["Inter", "Be Vietnam Pro", "Space Grotesk", "Nunito", "Lexend", "Quicksand", "JetBrains Mono", "Montserrat"],
      "description": "Font tiêu đề (h1-h3, số liệu lớn); thân bài luôn là typography.font-family. Mọi font trong danh sách có bộ ký tự tiếng Việt và giấy phép OFL"
    },
    "locked": { "type": "boolean", "description": "true: bảng màu do chủ dự án chốt tay, script sinh bỏ qua" },
    "lockedNote": { "type": "string" },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": { "light": { "$ref": "#/$defs/accent" }, "dark": { "$ref": "#/$defs/accent" } }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "accent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text-link", "primary", "primary-hover", "primary-active", "on-primary", "focus-ring", "accent", "glow", "icon-info", "icon-nav"],
      "properties": {
        "text-link": { "$ref": "#/$defs/hex" },
        "primary": { "$ref": "#/$defs/hex" },
        "primary-hover": { "$ref": "#/$defs/hex" },
        "primary-active": { "$ref": "#/$defs/hex" },
        "on-primary": { "$ref": "#/$defs/hex" },
        "focus-ring": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "glow": { "type": "string", "pattern": "^rgba\\(\\d{1,3}, \\d{1,3}, \\d{1,3}, (0|1|0?\\.\\d+)\\)$" },
        "icon-info": { "$ref": "#/$defs/hex" },
        "icon-nav": { "$ref": "#/$defs/hex" }
      }
    }
  }
}

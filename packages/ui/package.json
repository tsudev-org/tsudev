{
  "name": "@tsudev/ui",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.tsx",
  "dependencies": {
    "@tsudev/types": "*"
  },
  "module": "src/index.tsx",
  "scripts": {
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "build": "storybook build -o build --disable-telemetry",
    "build:lib": "esbuild src/index.tsx --bundle --format=esm --outfile=dist/index.js --platform=browser --external:react --external:react-dom --loader:.tsx=tsx --loader:.ts=ts --sourcemap",
    "test": "NODE_ENV=test jest --runInBand"
  },
  "devDependencies": {
    "@storybook/react": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "^10.6.6",
    "vite": "^8.3.6"
  },
  "peerDependencies": {
    "next-auth": "*",
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "next-auth": {
      "optional": false
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ]
  }
}

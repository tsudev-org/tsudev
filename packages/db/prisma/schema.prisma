// tsudev - Prisma schema
// Nền tảng dữ liệu chung cho toàn hệ thống (users, blog, docs, files, con dấu).
// Provider: PostgreSQL. Local dev chạy trên cluster user-space (port 5433).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  MEMBER
  VIP
  AUTHOR
  MODERATOR
  ADMIN
  OWNER
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique
  displayName String?
  avatarUrl   String?
  bio         String?
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Xác thực do codebase tự quản lý ---
  //
  // NULL được: tài khoản chỉ đăng nhập bằng GitHub/Google hoặc chỉ bằng passkey
  // thì không có mật khẩu nào cả. Đừng suy ra "chưa đăng ký" từ cột này.
  /// Argon2id. KHÔNG BAO GIỜ trả cột này ra khỏi tầng service.
  passwordHash        String?
  /// NULL = email chưa xác minh. Đường ghi nhạy cảm phải tự kiểm, vì tài khoản
  /// vẫn tồn tại và vẫn đăng nhập được trước khi xác minh.
  emailVerifiedAt     DateTime?
  /// Thu hồi phiên mà không cần bảng phiên. JWT mang số này; đổi mật khẩu hoặc
  /// "đăng xuất mọi thiết bị" thì tăng lên, và mọi token đã phát mất hiệu lực
  /// ngay. Phiên lưu DB sẽ đúng hơn về lý thuyết nhưng frontend chạy trên
  /// Cloudflare Workers còn DB ở Neon ap-southeast-1 - nghĩa là một truy vấn
  /// xuyên lục địa cho MỖI request.
  sessionVersion      Int       @default(0)
  /// Vô hiệu hoá MỀM do chính chủ: tài khoản ẩn/không dùng được, nhưng đăng nhập
  /// lại sẽ KHÔI PHỤC (xoá mốc này). NULL = đang hoạt động.
  deactivatedAt       DateTime?
  /// Hẹn XOÁ vĩnh viễn: đăng nhập lại trước mốc này thì huỷ hẹn (khôi phục);
  /// quá mốc mà đăng nhập thì tài khoản bị purge. NULL = không hẹn xoá.
  deletionScheduledAt DateTime?
  /// Đếm số lần sai LIÊN TIẾP; đăng nhập thành công đặt lại về 0.
  failedLoginCount    Int       @default(0)
  /// Khoá tạm sau quá nhiều lần sai. Khoá theo TÀI KHOẢN, khác với chặn theo IP
  /// ở LoginAttempt - thiếu một trong hai thì kẻ tấn công chỉ cần đổi trục.
  lockedUntil         DateTime?
  /// Lần gần nhất mật khẩu được đối chiếu kho rò rỉ HIBP (đăng ký, đặt lại, đổi,
  /// hoặc đăng nhập bằng mật khẩu khi lần kiểm trước đã quá 30 ngày). NULL = chưa
  /// từng kiểm - thẻ "Mức an toàn" hiện là "chưa rõ", KHÔNG phải "an toàn".
  passwordCheckedAt   DateTime?
  /// Kết quả của lần kiểm đó. Chỉ có nghĩa khi `passwordCheckedAt` khác NULL.
  /// HIBP không trả lời ⇒ KHÔNG ghi gì (fail-open không được giả làm "sạch").
  passwordBreached    Boolean   @default(false)
  lastLoginAt         DateTime?

  /// --- Dấu vết đăng nhập gần nhất, PHI CHUẨN HOÁ có chủ đích ---
  ///
  /// Ba cột này lặp lại thông tin đã có trong `SecurityEvent` của lần đăng nhập
  /// cuối. Lặp là cố ý: trang quản trị lọc theo IP/quốc gia/phương pháp trên
  /// hàng nghìn tài khoản, mà lấy chúng từ `SecurityEvent` nghĩa là "sự kiện mới
  /// nhất của từng người" - một truy vấn con cho MỖI dòng, và không lọc bằng
  /// chỉ mục được. Ghi thẳng vào đây ở đúng chỗ đang ghi `lastLoginAt` thì bộ
  /// lọc thành một câu WHERE có chỉ mục.
  ///
  /// `SecurityEvent` vẫn là sổ cái đầy đủ; ba cột này chỉ là ảnh chụp cuối cùng.
  /// Chúng PHẢI được ghi cùng lúc với `lastLoginAt`, không bao giờ tách ra -
  /// lệch nhau là trang quản trị nói một đằng, nhật ký bảo mật nói một nẻo.
  lastLoginIp      String?
  /// Mã quốc gia ISO-3166-1 alpha-2 do Cloudflare cấp (`CF-IPCountry`). Hai ký
  /// tự, hoặc "XX" khi Cloudflare không xác định được. KHÔNG suy ra từ IP ở đây
  /// - việc đó cần cơ sở dữ liệu GeoIP, để dành cho pha sau.
  lastLoginCountry String?
  /// 'password' | 'passkey' | 'oauth:github' | 'oauth:google'. Chuỗi chứ không
  /// enum: thêm nhà cung cấp là dữ liệu, không phải migration - giống hệt lý do
  /// `OAuthAccount.provider` là chuỗi.
  lastLoginMethod  String?

  posts Post[]
  files FileObject[]

  oauthAccounts  OAuthAccount[]
  passkeys       WebAuthnCredential[]
  totp           TotpCredential?
  backupCodes    BackupCode[]
  authTokens     AuthToken[]
  securityEvents SecurityEvent[]

  emailAliases           EmailAlias[]

  /// Trang quản trị lọc và sắp theo ba trục này. Không có chỉ mục thì mỗi lần
  /// lọc là một lượt quét toàn bảng.
  @@index([lastLoginAt])
  @@index([lastLoginCountry])
  @@index([role, createdAt])
}

/// Tài khoản bên thứ ba đã liên kết (GitHub, Google). Một User có thể liên kết
/// nhiều nhà cung cấp; mỗi tài khoản bên đó chỉ gắn được vào MỘT User.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "github" | "google" - chuỗi chứ không phải enum: thêm nhà cung cấp là dữ
  /// liệu, không phải migration.
  provider          String
  /// Định danh ổn định do nhà cung cấp cấp. KHÔNG dùng email làm khoá - email
  /// đổi được, và tin vào email của bên thứ ba là đường chiếm tài khoản.
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Passkey / WebAuthn.
model WebAuthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// credentialId do trình duyệt cấp, lưu dạng base64url.
  credentialId String    @unique
  publicKey    String
  /// Bộ đếm chống phát lại: giá trị mới phải LỚN HƠN giá trị đã lưu.
  counter      Int       @default(0)
  transports   String[]  @default([])
  /// Nhãn người dùng đặt để tự phân biệt thiết bị khi thu hồi.
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

/// Bí mật TOTP. Bảng riêng chứ không phải cột trên User: nó là bí mật cần mã
/// hoá, và để chung thì mọi truy vấn User bình thường đều kéo nó theo.
model TotpCredential {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Bí mật đã mã hoá bằng khoá ứng dụng, KHÔNG phải base32 thô.
  secretEnc   String
  /// NULL = đã tạo nhưng người dùng chưa nhập đúng mã lần đầu. Chưa xác nhận
  /// thì KHÔNG được coi là đã bật 2FA, nếu không người dùng tự khoá mình ra.
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Mã dự phòng dùng MỘT LẦN, cho trường hợp mất thiết bị TOTP.
model BackupCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chỉ lưu hash. Mã thô hiện đúng một lần lúc sinh ra.
  codeHash String
  usedAt   DateTime?

  @@index([userId])
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  /// Mã SỐ 6 chữ số người dùng tự gõ lại ở /settings/profile, khác
  /// `EMAIL_VERIFY` vốn là liên kết bấm một phát.
  ///
  /// ⚠️ Vì sao tách purpose thay vì dùng chung: hai thứ này có mức rủi ro khác
  /// nhau một trời một vực. Token liên kết dài 32 byte ngẫu nhiên - đoán được
  /// là chuyện không xảy ra. Mã 6 số chỉ có 10^6 khả năng, tức là ĐOÁN ĐƯỢC nếu
  /// không chặn số lần thử. Dùng chung một purpose thì hai vòng đời (24 giờ cho
  /// liên kết, 10 phút cho mã) và hai chính sách chặn phải nhét vào cùng một
  /// nhánh mã, và nhánh nào lỏng hơn sẽ quyết định mức an toàn của cả hai.
  EMAIL_VERIFY_CODE
  PASSWORD_RESET
  /// Đổi email: token gửi tới địa chỉ MỚI, tiêu token thì mới thay `User.email`.
  /// Địa chỉ đích nằm ở `AuthToken.newEmail` - xác minh trước, thay sau.
  EMAIL_CHANGE
  /// Nút "Không phải tôi" trong thư cảnh báo đăng nhập thiết bị mới: bấm ⇒ thu
  /// hồi MỌI phiên (`sessionVersion++`). Dùng một lần, sống 7 ngày.
  SESSION_REVOKE
}

/// Token một lần gửi qua email.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  /// HASH của token, không phải token. Rò một bản sao DB thì không được phép
  /// biến thành khả năng đặt lại mật khẩu của mọi tài khoản đang chờ.
  tokenHash String           @unique
  /// Chỉ dùng với purpose EMAIL_CHANGE: địa chỉ email MỚI đang chờ xác minh.
  /// NULL với các purpose khác. Lưu ở token (không phải ở User) để email hiện
  /// tại không bị đổi trước khi chủ tài khoản chứng minh quyền kiểm soát địa chỉ
  /// mới - "xác minh trước, thay sau".
  newEmail  String?
  /// Số lần gõ SAI đã ghi nhận. Chỉ có nghĩa với `EMAIL_VERIFY_CODE`.
  ///
  /// ⚠️ Đây là thứ duy nhất đứng giữa một mã 6 số và việc dò cạn 10^6 khả năng.
  /// Chặn tần suất GỬI không thay được nó: kẻ tấn công không cần gửi thêm mã
  /// nào, chỉ cần gõ liên tục vào một mã đang có hiệu lực.
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Challenge WebAuthn đang chờ trả lời.
///
/// Phải có TRẠNG THÁI: giao thức yêu cầu máy chủ tự nhớ challenge nó vừa phát
/// và đối chiếu với cái quay về. Gửi challenge kèm chữ ký cho client giữ hộ sẽ
/// phá đúng tính chất mà challenge tồn tại để bảo đảm - chống phát lại.
///
/// `userId` NULL được: lúc đăng nhập bằng passkey khám phá được, máy chủ chưa
/// biết đó là ai cho tới khi chữ ký được kiểm xong.
model WebAuthnChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String
  /// 'register' | 'login'. Không dùng chung challenge giữa hai luồng.
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Nhật ký thử đăng nhập, phục vụ giới hạn tần suất theo IP.
///
/// Nằm ở DB chứ không phải Redis vì .env.production.example khai REDIS_URL
/// nhưng Render KHÔNG có instance Redis nào và không dòng mã nào đọc biến đó.
/// Thà chậm hơn một chút còn hơn một lớp phòng thủ chỉ tồn tại trên giấy.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// IP hoặc tên đăng nhập - trục nào đang bị đếm.
  identifier String
  succeeded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([createdAt])
}

/// Bộ đếm giới hạn tần suất LƯU BỀN (G9, quyết định D8): cửa sổ CỐ ĐỊNH, mỗi
/// (khoá, đầu cửa sổ) một dòng, tăng bằng một câu upsert nguyên tử. Sống qua khởi
/// động lại và nhiều bản chạy - bộ đếm trong RAM thì không.
///
/// CHỈ dùng cho tầng NHẠY CẢM (mật khẩu, mã 6 số, token, đăng ký) - lưu lượng
/// thấp. Tầng chung đếm mọi request vẫn ở RAM: ghi DB cho mỗi request là biến
/// bộ đếm thành nguồn tải và giữ Neon thức (docs/free-tier.md). Cron dọn dòng
/// có `windowStart` cũ hơn 1 ngày.
model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Nhật ký sự kiện bảo mật của tài khoản: đăng nhập, đổi mật khẩu/email, bật/tắt
/// 2FA, thêm/xoá passkey. Bề mặt cho chính chủ ("Hoạt động gần đây") và cho OWNER
/// (console xuyên tài khoản).
///
/// TÁCH RIÊNG khỏi `TrustAuditLog` có chủ đích: TrustAuditLog phục vụ trách nhiệm
/// pháp lý của Con dấu và có console OWNER đọc 100 dòng gần nhất - đổ mọi lượt
/// đăng nhập vào đó sẽ nhấn chìm sự kiện Con dấu. Sự kiện admin/vai trò
/// (invite.*, user.*) vẫn ở TrustAuditLog; bảng này chỉ giữ sự kiện tự-phục-vụ.
/// Bí danh thư nội bộ `*@tsudev.com`, đối chiếu với Cloudflare Email Routing.
///
/// Đây là BẢN SAO, không phải nguồn sự thật. Nguồn sự thật là Cloudflare: thư
/// đi theo quy tắc bên đó, không theo bảng này. Bảng này tồn tại để trang quản
/// trị gắn được bí danh với TÀI KHOẢN (thứ Cloudflare không biết) và để hiện
/// danh sách mà không phải gọi API ở mỗi lần tải trang.
///
/// Hai bên lệch nhau là chuyện BÌNH THƯỜNG - ai đó sửa tay trên bảng điều khiển
/// Cloudflare là lệch. Vì thế có thao tác đối soát, và mọi chỗ đọc phải coi
/// `cfRuleId = NULL` là "chưa tồn tại thật", không phải "sắp có".
model EmailAlias {
  id String @id @default(cuid())

  /// Phần trước dấu @, đã chuẩn hoá về chữ thường: `lien-he` cho
  /// lien-he@tsudev.com. Lưu riêng phần này chứ không lưu cả địa chỉ vì tên
  /// miền là cấu hình (`INTERNAL_MAIL_DOMAIN`), không phải dữ liệu.
  localPart String @unique

  /// Hộp thư nhận chuyển tiếp. Cloudflare CHỈ chuyển tới địa chỉ đã xác minh ở
  /// phía họ - đặt một địa chỉ chưa xác minh thì quy tắc tạo ra vẫn im lặng
  /// không giao thư.
  destination String

  /// Định danh quy tắc bên Cloudflare. NULL = bảng này có mà Cloudflare KHÔNG -
  /// bí danh chưa sống, thư gửi tới sẽ trả về. Trạng thái này phải nhìn thấy
  /// được trên giao diện, đừng ẩn nó đi.
  cfRuleId String?

  /// Tài khoản sở hữu. NULL = bí danh dùng chung (lien-he@, bao-mat@) không
  /// thuộc riêng ai.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Ai THỰC HIỆN, nếu khác chủ tài khoản (OWNER thao tác lên user khác). NULL =
  /// chính chủ. Lưu kèm `actorName` để hiện được mà không cần join.
  actorId   String?
  actorName String?
  /// Mã sự kiện ổn định: 'login', 'password_change', 'email_changed'... Chuỗi
  /// chứ không enum - thêm loại sự kiện là dữ liệu, không phải migration.
  type      String
  /// IP và User-Agent của người gây ra sự kiện, để chủ tài khoản nhận ra đăng
  /// nhập bất thường. Dữ liệu cá nhân - chỉ chủ tài khoản và OWNER đọc được.
  ip        String?
  /// Mã quốc gia ISO-3166-1 alpha-2 lấy từ header `CF-IPCountry` của Cloudflare
  /// - miễn phí và chính xác vì frontend vốn đã chạy trên Workers. NULL với mọi
  /// sự kiện ghi TRƯỚC khi cột này ra đời, và với lời gọi không đi qua tầng
  /// biên (test, kịch bản nội bộ). Đừng suy ra quốc gia từ `ip` ở tầng đọc: dữ
  /// liệu cũ sẽ im lặng khác dữ liệu mới.
  country   String?
  userAgent String?
  note      String?
  createdAt DateTime @default(now())
  /// SHA-256 (hex) của dòng TRƯỚC của CÙNG tài khoản - chuỗi băm theo từng
  /// userId (G8, docs/security-plan.md). Do TRIGGER đặt lúc INSERT, ứng dụng
  /// không ghi. NULL = dòng đầu chuỗi. Chuỗi theo user chứ không toàn bảng vì
  /// bảng này có hai đường xoá hợp lệ, cả hai cắt trọn ĐẦU chuỗi của một user:
  /// tự dọn quá 90 ngày, và cascade khi purge tài khoản. Trigger chặn mọi UPDATE
  /// và mọi DELETE khác (migration 20261106120000_an_ninh_phat_hanh).
  prevHash  String?

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Content: Blog & Docs
// ---------------------------------------------------------------------------
model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String?
  contentMd String
  tags      String[] @default([])
  published Boolean  @default(true)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Xuất bản & lên lịch ---
  /// NGÀY HIỂN THỊ, do tác giả sửa được. `createdAt` giữ nguyên làm dấu vết audit
  /// bất biến. Mọi đường đọc công khai xếp/lọc theo trường này (fallback createdAt
  /// nếu NULL cho dữ liệu cũ). LÊN LỊCH: `published=true` + `publishedAt` tương lai
  /// ⇒ bài ẩn tới giờ hẹn - đường đọc công khai PHẢI thêm `publishedAt <= now()`.
  publishedAt DateTime?

  /// --- Nội dung nâng cao ---
  /// Nguồn tham khảo: mảng JSON [{ label, url }]. Render ở vùng "Nguồn tham khảo".
  references      Json?
  /// Ảnh bìa (URL trong object storage). Hiển thị đầu bài + thẻ OG.
  coverImageUrl   String?
  /// Mô tả SEO/OG. Rỗng ⇒ suy từ excerpt.
  metaDescription String?

  /// --- Chỉ mục tìm kiếm (SEARCH_AND_FILTER.md) ---
  /// Bản đã CHUẨN HOÁ (NFC → thường → bỏ dấu, đ→d) để so khớp không dấu. TÍNH SẴN
  /// tại thời điểm ghi qua @tsudev/search, KHÔNG tìm trực tiếp trên title/contentMd.
  /// Backfill bằng `npm run search:reindex`. Có index GIN pg_trgm (thêm ở migration).
  searchTitleNorm String?
  searchBodyNorm  String?

  /// --- Toà soạn Agent AI ---
  /// Xoá mềm. Mọi truy vấn đọc công khai PHẢI thêm `deletedAt: null`; quên một
  /// chỗ là bài đã xoá vẫn hiện ra. Xoá cứng bị trigger Postgres chặn.
  deletedAt         DateTime?
  /// Bản nháp đã sinh ra bản ghi này, để lần ngược về lịch sử phiên bản.
  sourceDraftId     String?
  /// AgentProfile.id của agent đã viết. NULL = do người viết (dữ liệu seed cũ).
  authoredByAgentId String?

  @@index([published, createdAt])
  @@index([published, publishedAt])
  @@index([deletedAt])
  @@index([tags], type: Gin)
  // Index trigram trên cột đã chuẩn hoá - so khớp không dấu/gần đúng không quét
  // toàn bảng. `map` khớp tên index dựng tay trong migration để Prisma không báo lệch.
  @@index([searchTitleNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_searchTitleNorm_trgm_idx")
  @@index([searchBodyNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Post_searchBodyNorm_trgm_idx")
}

model Doc {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  contentMd String
  category  String   @default("general")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Chỉ mục tìm kiếm (SEARCH_AND_FILTER.md) ---
  /// Giống hệt cặp cột của Post và vì đúng lý do đó: bản đã CHUẨN HOÁ (NFC →
  /// thường → bỏ dấu, đ→d) để so khớp không dấu, TÍNH SẴN lúc GHI qua
  /// @tsudev/search. Doc không có cột tóm tắt nên `searchBodyNorm` chỉ gộp thân
  /// bài đã rút văn bản thuần. Backfill bằng `npm run search:reindex` (script đó
  /// lập chỉ mục CẢ Post lẫn Doc). Có index GIN pg_trgm (thêm ở migration).
  searchTitleNorm String?
  searchBodyNorm  String?

  /// --- Toà soạn Agent AI ---
  /// Xoá mềm. Mọi truy vấn đọc công khai PHẢI thêm `deletedAt: null`; quên một
  /// chỗ là bài đã xoá vẫn hiện ra. Xoá cứng bị trigger Postgres chặn.
  deletedAt         DateTime?
  /// Bản nháp đã sinh ra bản ghi này, để lần ngược về lịch sử phiên bản.
  sourceDraftId     String?
  /// AgentProfile.id của agent đã viết. NULL = do người viết (dữ liệu seed cũ).
  authoredByAgentId String?

  @@index([category, position])
  @@index([deletedAt])
  /// ⚠️ Hai index này PHẢI được khai ở đây, không chỉ ở migration của DOCS-SEARCH.
  /// Prisma sinh migration bằng cách so schema với database: index có trong DB mà
  /// KHÔNG có trong schema thì nó coi là trôi lệch và sinh `DROP INDEX`. Phát hiện
  /// 26/08/2026 - migration kế tiếp (`email_verify_code`) tự động kèm hai lệnh xoá
  /// đúng hai index này. Hậu quả nếu lọt: tìm kiếm tài liệu VẪN CHẠY, chỉ là quét
  /// toàn bảng - chậm dần theo lượng dữ liệu, không có gì báo lỗi. `Post` đã khai
  /// đúng từ đầu; `Doc` bị bỏ sót.
  @@index([searchTitleNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Doc_searchTitleNorm_trgm_idx")
  @@index([searchBodyNorm(ops: raw("gin_trgm_ops"))], type: Gin, map: "Doc_searchBodyNorm_trgm_idx")
}

// ---------------------------------------------------------------------------
// Storage
// ---------------------------------------------------------------------------
model FileObject {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  contentType String
  size        Int      @default(0)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Nhật ký quản trị (di sản của Con dấu tín nhiệm - xem chú thích model)
// ---------------------------------------------------------------------------

/// Nhật ký bất biến cho thao tác QUẢN TRỊ lên tài khoản (auth-service: useradmin).
/// Sinh ra cùng Con dấu tín nhiệm nên mang tên Trust*; Con dấu đã gỡ 04/11/2026
/// nhưng bảng ĐƯỢC GIỮ vì đây là người dùng còn lại của nó. Đổi tên bảng là một
/// RENAME - không đáng rủi ro chỉ vì cái tên.
model TrustAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  action      String
  targetType  String
  targetId    String
  targetLabel String?
  note        String?
  createdAt   DateTime @default(now())
  /// SHA-256 (hex) của dòng ngay trước trong toàn bảng - chuỗi băm (G8). Do
  /// TRIGGER đặt lúc INSERT (kèm `createdAt` = clock_timestamp() dưới khoá
  /// advisory, để thứ tự chuỗi trùng thứ tự thời gian). NULL = dòng đầu. Xoá một
  /// dòng ở giữa làm đứt chuỗi; UPDATE/DELETE bị trigger chặn.
  prevHash    String?

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Dự án & bản quyền - trọng tâm mới của website
//
// Mỗi dòng là một dự án/tool/phần mềm do tsudev phát triển. Ba nhóm trường:
// giới thiệu, phát hành, và bản quyền. Nhóm bản quyền là cầu nối sang Con dấu
// tín nhiệm: dự án có bản quyền -> website dùng dự án đó -> được cấp huy hiệu.
// ---------------------------------------------------------------------------

enum ProjectKind {
  APP
  TOOL
  LIBRARY
  SERVICE
}

/// Nền tảng của một bản phát hành tải về được.
///
/// SOURCE và WEB không phải "tệp tải về" theo nghĩa thường, nhưng chúng thuộc
/// cùng một bảng có chủ đích: trang tải về cần liệt kê ĐỦ mọi cách dùng được
/// phần mềm, và một dự án chỉ có mã nguồn vẫn phải xuất hiện ở đó thay vì trông
/// như chưa phát hành.
enum ReleasePlatform {
  ANDROID
  WINDOWS
  MACOS
  LINUX
  WEB
  SOURCE
}

/// Sự cố an ninh ĐÃ GHI NHẬN của một bản phát hành (G4, G5). Chỉ giữ các trạng
/// thái là SỰ KIỆN đã xảy ra; các trạng thái suy được (chưa niêm phong, khoá đã
/// nghỉ, đã thu hồi) do máy chủ tính lúc đọc - lưu chúng là để hai nguồn sự thật
/// lệch nhau. Khác OK ⇒ không công bố được.
enum ReleaseSecurityState {
  OK
  /// Băm lại tệp trong kho KHÔNG khớp sha256 đã ký ⇒ đã tự gỡ công bố.
  LECH_TOAN_VEN
  /// Tra băm trên VirusTotal có phát hiện ⇒ đã tự gỡ công bố.
  NGHI_MA_DOC
}

/// Kênh phát hành. Trang công khai mặc định chỉ hiện STABLE.
enum ReleaseChannel {
  STABLE
  BETA
  ALPHA
}

enum ProjectStatus {
  WIP
  BETA
  STABLE
  ARCHIVED
}

/// NONE: chưa nộp · PENDING: đã nộp, đang chờ · REGISTERED: đã có giấy chứng nhận.
enum CopyrightStatus {
  NONE
  PENDING
  REGISTERED
}

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  summary       String
  descriptionMd String        @default("")
  kind          ProjectKind   @default(TOOL)
  status        ProjectStatus @default(WIP)

  // Phát hành
  version     String?
  releasedAt  DateTime?
  repoUrl     String?
  homepageUrl String?
  downloadUrl String?
  /// Mã giấy phép theo SPDX (MIT, Apache-2.0, ...). Để trống nghĩa là chưa công bố.
  license     String?

  // Bản quyền
  copyrightStatus CopyrightStatus @default(NONE)
  /// Số giấy chứng nhận đăng ký quyền tác giả. Chỉ có nghĩa khi status=REGISTERED.
  copyrightNo     String?
  copyrightAt     DateTime?
  copyrightOwner  String?

  featured  Boolean  @default(false)
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// --- Toà soạn Agent AI ---
  /// Xoá mềm, thêm ở đợt 5. Route DELETE /api/admin/projects/:slug đã đổi sang
  /// đặt cột này TRƯỚC khi trigger chặn xoá cứng được gắn cho bảng Project -
  /// đảo thứ tự là làm hỏng một tính năng đang chạy được.
  deletedAt DateTime?

  releases ProjectRelease[]

  @@index([published, sortOrder])
  @@index([deletedAt])
  @@index([kind, status])
  @@index([copyrightStatus])
}

/// Một tệp phát hành tải về được của một dự án.
///
/// ──────────────────────────────────────────────────────────────────────────────
/// VÌ SAO LÀ MỘT BẢNG RIÊNG, KHÔNG PHẢI THÊM CỘT VÀO Project
/// ──────────────────────────────────────────────────────────────────────────────
///
/// `Project.downloadUrl` là MỘT chuỗi. Nó không mô tả nổi "app la bàn cho
/// Android" và "công cụ quét cho Windows" của cùng một dự án, chưa nói tới nhiều
/// phiên bản, nhiều kiến trúc, hay kênh beta. Cột đó nay là DI SẢN: nó vẫn ở lại
/// cho những dự án chỉ có một đường tải duy nhất, nhưng trang tải về đọc bảng
/// này trước.
///
/// ──────────────────────────────────────────────────────────────────────────────
/// `sha256` VÀ `signature` KHÔNG PHẢI TRANG TRÍ
/// ──────────────────────────────────────────────────────────────────────────────
///
/// Phát hành app ngoài store gặp hai rào cản thật: Windows SmartScreen cảnh báo
/// mọi tệp không có chứng chỉ ký mã, và Android chặn "nguồn không xác định". Dự
/// án cá nhân không mua được chứng chỉ ký mã, nên thứ duy nhất ta cho người tải
/// được là một checksum công khai và một chữ ký kiểm được.
///
/// Và repo này có sẵn hạ tầng cho việc đó: `@tsudev/trust-crypto` ký Ed25519 và
/// JWKS công khai ở `/.well-known/tsudev-release-jwks.json`. Dùng nó để ký chính
/// tệp phát hành của mình là hệ con dấu tín nhiệm tự áp lên bản thân.
model ProjectRelease {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Theo semver. Chuỗi chứ không phải ba số nguyên: hậu tố `-rc.1`, `+build`
  /// là phần hợp lệ của semver và sẽ mất nếu tách ra.
  version  String
  channel  ReleaseChannel  @default(STABLE)
  platform ReleasePlatform
  /// arm64, x86_64, universal...
  ///
  /// 🔴 KHÔNG NULL ĐƯỢC, và đây là một bất biến đã được ĐO, không phải sở thích.
  ///
  /// Bản đầu khai `arch String?`. Trong SQL `NULL != NULL`, nên ràng buộc
  /// `@@unique([projectId, version, platform, arch])` KHÔNG hề chặn trùng khi
  /// `arch` bỏ trống - mà bỏ trống là trường hợp phổ biến nhất (WEB, SOURCE, và
  /// mọi bản dựng một-kiến-trúc). Đã kiểm trực tiếp trên Postgres: hai lượt
  /// INSERT cùng (projectId, version, platform) với arch NULL đều lọt, cho ra
  /// hai hàng y hệt nhau.
  ///
  /// Hỏng im lặng theo đúng nghĩa: ràng buộc vẫn ở đó, `\d` vẫn in nó ra, test
  /// trùng-lặp vẫn xanh - vì test đó truyền `arch: 'arm64'`.
  ///
  /// Chuỗi RỖNG nghĩa là "không phân biệt kiến trúc". API công khai chuyển nó
  /// thành `null` lúc trả ra (`releaseCard`), nên hợp đồng đối ngoại không đổi.
  arch     String          @default("")

  /// Khoá trong R2, KHÔNG phải URL công khai.
  ///
  /// Lưu khoá thay vì URL là có chủ đích: URL công khai của bucket đổi theo môi
  /// trường (`S3_PUBLIC_ENDPOINT` khác nhau ở dev và production), nên ghi URL
  /// vào database là nhúng cấu hình môi trường vào dữ liệu. Ngoài ra lượt tải
  /// phải đi qua route đếm, không đi thẳng vào R2.
  ///
  /// Null khi nền tảng là WEB hoặc SOURCE - lúc đó `externalUrl` mang đường dẫn.
  storageKey  String?
  /// Đường dẫn ngoài, dùng cho WEB (địa chỉ app) và SOURCE (repo, tag release).
  externalUrl String?

  fileName   String?
  /// Byte. Int đủ tới 2 GB - vượt mức đó thì repo này đã có vấn đề khác to hơn.
  fileSize   Int?
  /// Chữ thập lục phân 64 ký tự. Người tải đối chiếu được bằng `sha256sum`.
  sha256     String?
  /// Chữ ký Ed25519 của `sha256`, base64url. Kiểm bằng khoá công khai ở JWKS.
  signature  String?
  /// `kid` của khoá đã ký. BẮT BUỘC đi cùng `signature`: vòng khoá có xoay, nên
  /// một chữ ký không nói nó được ký bằng khoá nào là một chữ ký không kiểm được
  /// sau lần xoay đầu tiên.
  signingKid String?

  releaseNotesMd String  @default("")
  /// "Android 8.0+", "Windows 10 64-bit"... Chuỗi tự do vì mỗi nền tảng diễn
  /// đạt phiên bản tối thiểu theo một cách khác nhau.
  minOsVersion   String?

  downloadCount Int       @default(0)
  /// Null = bản nháp, chưa hiện ra công khai.
  publishedAt   DateTime?
  deletedAt     DateTime?

  // --- Trung tâm an ninh phát hành (docs/security-plan.md §3) ---
  /// Sự cố đã ghi nhận. Trạng thái hiển thị đầy đủ tính ở content-service.
  securityState   ReleaseSecurityState @default(OK)
  /// Lần gần nhất máy chủ băm lại tệp trong kho và so với sha256 đã ký.
  lastIntegrityAt DateTime?
  /// Thu hồi: ẩn khỏi trang công khai, chặn link tải, GIỮ tệp để điều tra.
  /// Bắt buộc kèm lý do và step-up (TOTP < 5 phút).
  revokedAt       DateTime?
  revokeReason    String?
  /// Kết quả tra băm VirusTotal: { status, malicious, suspicious, checkedAt }.
  /// `status` = CHUA_QUET (thiếu khoá - KHÔNG giả vờ đã quét) | CHUA_CO_DU_LIEU |
  /// SACH | PHAT_HIEN | LOI. NULL = chưa từng tra.
  scanResult      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Một dự án không thể có hai bản cùng phiên bản, cùng nền tảng, cùng kiến
  /// trúc. Đây là bất biến THẬT, không phải phòng xa: đường ghi của trang quản
  /// trị là "tải tệp lên rồi khai phiên bản", và bấm hai lần là chuyện thường.
  @@unique([projectId, version, platform, arch])
  @@index([projectId, publishedAt])
  @@index([deletedAt])
  @@index([securityState])
}

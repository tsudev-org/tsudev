# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Postgres
POSTGRES_USER=tsudev
POSTGRES_PASSWORD=tsudev
POSTGRES_DB=tsudev

# --- Địa chỉ frontend ---
# tsudev chỉ còn MỘT app và MỘT origin, nên điều hướng trong site dùng href
# tương đối. Biến này chỉ phục vụ các chỗ BẮT BUỘC cần URL tuyệt đối: thẻ
# canonical, ảnh OG, mã nhúng huy hiệu tín nhiệm.
# Lên production đổi thành https://tsudev.com.
NEXT_PUBLIC_MAIN_URL=http://tsudev.localhost:8080

# NextAuth (dev)
# NEXTAUTH_URL phải khớp origin của CHÍNH app đang chạy, nếu không callback đăng
# nhập sẽ nhảy sang app kia. Giá trị dưới đây chỉ là mặc định cho frontend-main;
# scripts/write-env-local.js tự ghi đè đúng URL cho từng app khi chạy dev.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-secret
# Miền cookie phiên. Phải là miền cha của mọi host dev, nếu không đăng nhập
# không dính (xem CLAUDE.md).
NEXTAUTH_COOKIE_DOMAIN=.tsudev.localhost

# Database (Postgres). Local dev user-space cluster: port 5433
DATABASE_URL=postgresql://tsudev:tsudev@localhost:5433/tsudev?schema=public

# --- Khoá ký BẢN PHÁT HÀNH (content-service, src/releaseSigning.ts) ---
# PEM PKCS#8 Ed25519 đã base64 hoá. Sinh bằng: node services/content-service/scripts/genkey.js
# Để trống ở local -> dùng khoá dev công khai và cảnh báo; production thiếu thì
# service TỪ CHỐI khởi động. Khoá công khai: /.well-known/tsudev-release-jwks.json
#
# Đổi tên HAI ĐỢT từ TRUST_SIGNING_* (Con dấu đã gỡ 04/11/2026): mã đọc tên mới
# trước, thiếu thì lùi về tên cũ. Đặt tên mới trên Render TRƯỚC, gỡ tên cũ SAU.
RELEASE_SIGNING_KEY=
RELEASE_SIGNING_KEY_ID=
# Khoá đã nghỉ, chỉ để XÁC MINH: "kid:<base64 PEM công khai>" ngăn bằng dấu phẩy.
RELEASE_SIGNING_KEYS_RETIRED=

# Email giao dịch (auth-service). Để trống ở dev: không gửi thư thật, chỉ ghi
# cảnh báo ra log. Liên kết xác minh/đặt lại vẫn tạo được và đọc được từ log.
RESEND_API_KEY=
MAIL_FROM=tsudev <no-reply@tsudev.localhost>
# Khoá ký KHẲNG ĐỊNH DANH TÍNH mà BFF gửi xuống service (@tsudev/identity-token).
# Tối thiểu 32 ký tự. Thiếu ⇒ service trả 503 chứ không im lặng cho qua.
# Ở production PHẢI là giá trị ngẫu nhiên riêng, đặt qua secret manager.
INTERNAL_IDENTITY_SECRET=dev-only-identity-secret-khong-dung-o-production-0123456789
# Đăng nhập bằng bên thứ ba (tuỳ chọn ở dev). Để trống ⇒ provider không xuất
# hiện trên /login, thay vì hiện một nút bấm không đăng nhập được.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khoá mã hoá bí mật TOTP khi lưu vào DB. Tối thiểu 32 ký tự.
# Bí mật TOTP KHÔNG băm được (kiểm mã cần chính giá trị đó) nên nó phải được mã
# hoá, với khoá nằm NGOÀI DB - một bản sao DB bị rò mà không kèm khoá này thì
# không sinh được mã của ai cả. Đổi khoá làm mọi thiết bị 2FA đang dùng hỏng.
TOTP_ENCRYPTION_KEY=dev-only-totp-encryption-key-khong-dung-o-production-0123456789
# Cloudflare. `wrangler` đọc biến này lúc deploy - GIỮ dù Toà soạn Agent AI (người
# dùng cũ của nó) đã gỡ 29/10/2026. Xoá mò là hỏng deploy.
CF_ACCOUNT_ID=
# --- Báo động (packages/observability/notify.js) ---------------------------
# Thiếu hai biến này thì `notify.alert()` chỉ `console.log` nội dung lẽ ra phải
# gửi - an toàn cho local, nhưng ở production nghĩa là báo động của
# `migrationGate` đi vào hư không. Đó là trạng thái thật của repo tới 29/10/2026.
#
# Hướng dẫn lấy giá trị + nghiệm thu: docs/alerting.md
# ⚠️ Worker cron cần RIÊNG hai biến này: `npm run cron:secret-telegram`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# >>> topology: sinh tự động, đừng sửa tay >>>
CONTENT_SERVICE_URL=http://localhost:4001
STORAGE_SERVICE_URL=http://localhost:4002
AUTH_SERVICE_URL=http://localhost:4004
CORS_ALLOWED_ORIGINS=http://tsudev.localhost:8080
S3_PUBLIC_ENDPOINT=http://cdn.tsudev.localhost:8080
BIND_HOST=127.0.0.1
# <<< topology <<<

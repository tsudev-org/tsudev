{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -L --watch src --ext ts,json --exec 'tsc -b ../.. && node dist/index.js'",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "NODE_ENV=test jest --runInBand && node --test test/oidc.node.test.mjs",
    "pretest": "tsc -b ../.."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@simplewebauthn/server": "14.1.0",
    "@tsudev/auth": "*",
    "@tsudev/db": "*",
    "@tsudev/ratelimit": "*",
    "@tsudev/types": "*",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "oidc-provider": "9.14.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jose": "^4.15.9",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.node\\.test\\.mjs$"
    ]
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}

{
  "name": "content-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -L --watch src --ext ts,json --exec 'tsc -b ../.. && node dist/index.js'",
    "test": "NODE_ENV=test jest --runInBand",
    "pretest": "tsc -b ../..",
    "search:reindex": "tsc -b ../.. && node dist/scripts/reindex-search.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@tsudev/auth": "*",
    "@tsudev/db": "*",
    "@tsudev/ratelimit": "*",
    "@tsudev/search": "*",
    "@tsudev/trust-crypto": "*",
    "@tsudev/types": "*",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "jest": "^29.6.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}

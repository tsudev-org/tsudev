{
  "name": "backend-bundle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -L --watch ../content-service/src --watch ../storage-service/src --ext ts,json --exec 'tsc -b ../.. && node dist/index.js'",
    "test": "NODE_ENV=test jest --runInBand",
    "pretest": "tsc -b ../.."
  },
  "dependencies": {
    "@tsudev/db": "*",
    "auth-service": "*",
    "content-service": "*",
    "express": "^4.22.3",
    "storage-service": "*"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}

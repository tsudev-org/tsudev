{
  "name": "storage-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon -L --watch src --ext ts,json --exec 'tsc -b ../.. && node dist/index.js'",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "test": "NODE_ENV=test jest --runInBand",
    "pretest": "tsc -b ../.."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@tsudev/auth": "*",
    "@tsudev/db": "*",
    "@tsudev/ratelimit": "*",
    "@tsudev/types": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "preset": "ts-jest"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts"
}
